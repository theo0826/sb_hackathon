{
  "name": "seongbuk-fit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "postbuild": "node tools/finalize-export.mjs",
    "start": "node tools/serve-pages.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:frontend": "eslint . --ignore-pattern \"components/ClothSim/**\"",
    "check:ai": "node tools/check-ai-readiness.mjs",
    "check:sharing": "node tools/check-sharing.mjs",
    "test:unit": "node tests/design-contract.mjs && node tests/production-mapping.mjs && node tests/ai-client-contract.mjs && node tests/order-workflow.mjs && node tests/saved-cloth.mjs && node tests/supplier-bids.mjs && node tests/order-history.mjs && node tests/capture-background.mjs",
    "build:pages": "npm run build",
    "preview:pages": "node tools/serve-pages.mjs",
    "test:pages": "node tests/pages-export.mjs",
    "predeploy": "npm run lint:frontend && npm run typecheck && npm run test:unit && npm run build && npm run test:pages",
    "deploy": "gh-pages -d out -b gh-pages --dotfiles --nojekyll"
  },
  "dependencies": {
    "jspdf": "4.2.1",
    "lucide-react": "1.56.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "gh-pages": "^6.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
