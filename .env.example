# New backend endpoints only. Public URLs, never personal API keys.
# Leave empty until the backend team provides the new APIs.
NEXT_PUBLIC_AI_DESIGN_URL=
NEXT_PUBLIC_AI_QUOTE_URL=

# Team ClothSim Worker; its keys stay on the Worker. Defaults to this URL when omitted.
NEXT_PUBLIC_CLOTH_WORKER_URL=https://clothsim-api.set35230.workers.dev

# Retired personal integrations stay disabled, even if old private keys exist locally.
LEGACY_BACKEND_ENABLED=false
OPENAI_ENABLED=false
